    <section id="features" class="py-5">
      <div class="container">
        <div class="text-center mb-5">
          <div class="text-uppercase small text-secondary fw-semibold mb-2">Why choose Files2Zip?</div>
          <h2 class="section-title display-6">Trust, clarity, and speed</h2>
        </div>
        <div class="row g-4">

          <div class="col-md-6 col-xl-3">
            <div class="feature-card">
              <div class="icon-wrap mb-3">
                <iconify-icon icon="lucide:file-archive"></iconify-icon>
              </div>
              <h3 class="h5">Multiple formats</h3>
              <p class="text-secondary mb-0">Files2zip can extract Zip, 7-Zip, RAR and TAR archives, all in the browser.</p>
            </div>
          </div>


          <div class="col-md-6 col-xl-3">
            <div class="feature-card">
              <div class="icon-wrap mb-3">
                <iconify-icon icon="lucide:cloud-off"></iconify-icon>
              </div>
              <h3 class="h5">100% Client-side</h3>
              <p class="text-secondary mb-0">Files never touch a server. All compression happens in your browser via WebAssembly-grade zip.js.</p>            </div>
          </div>

          <div class="col-md-6 col-xl-3">
            <div class="feature-card">
              <div class="icon-wrap mb-3">
                <iconify-icon icon="lucide:lock"></iconify-icon>
              </div>
              <h3 class="h5">Privacy by default</h3>
              <p class="text-secondary mb-0">No accounts, no tracking, no upload queue. Your data stays on your device, period.</p>
            </div>
          </div>

          <div class="col-md-6 col-xl-3">
            <div class="feature-card">
              <div class="icon-wrap mb-3">
                <iconify-icon icon="lucide:eye"></iconify-icon>
              </div>
              <h3 class="h5">Preview before download</h3>
              <p class="text-secondary mb-0">Preview files that your browser can render (images, audio, videos, .txt and .html) before downloading them.</p>
            </div>
          </div>

          <div class="col-md-6 col-xl-3">
            <div class="feature-card">
              <div class="icon-wrap mb-3">
                <iconify-icon icon="lucide:folder-tree"></iconify-icon>
              </div>
              <h3 class="h5">Folders &amp; nesting</h3>
              <p class="text-secondary mb-0">Drop single files or entire directories and view the folder structure in your archive.</p>
            </div>
          </div>

          <div class="col-md-6 col-xl-3">
            <div class="feature-card">
              <div class="icon-wrap mb-3">
                <iconify-icon icon="lucide:infinity"></iconify-icon>
              </div>
              <h3 class="h5">No file limits</h3>
              <p class="text-secondary mb-0">As many files as your browser can hold. No daily caps, no premium tier, no signup.</p>
            </div>
          </div>

          <div class="col-md-6 col-xl-3">
            <div class="feature-card">
              <div class="icon-wrap mb-3">
                <iconify-icon icon="lucide:zap"></iconify-icon>
              </div>
              <h3 class="h5">Instant &amp; offline</h3>
              <p class="text-secondary mb-0">Because files are compressed locally, there is no upload delay. Compression finishes as fast as your device can process it.</p>
            </div>
          </div>

          <div class="col-md-6 col-xl-3">
            <div class="feature-card">
              <div class="icon-wrap mb-3">
                <iconify-icon icon="lucide:globe"></iconify-icon>
              </div>
              <h3 class="h5">Works everywhere</h3>
              <p class="text-secondary mb-0">Any modern browser, any OS — desktop or mobile. No install, no plugins, no app.</p>
            </div>
          </div>

