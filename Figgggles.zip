  <main>
    <section class="hero">
      <div class="container">
        <div class="row align-items-center">
          <div class="text-center">
            <h1 class="display-3 display-title">
              Zip and unzip files online              <span class="text-primary">without sending them away</span>
            </h1>

            <p class="hero-copy my-5">
              <a href="#tools" data-process="zip">Create ZIP archive</a>: drop your files, create a ZIP archive and download a clean ZIP file. No server round-trip — your files never leave your device.              <br>
              <a href="#tools" data-process="unzip">Extract archive</a>: drop a ZIP file (RAR, TAR and 7-Zip are also supported) and preview its contents. Download individual files or all at once.            </p>

            <div class="hero-badges d-flex flex-wrap justify-content-center gap-3">
              <div class="eyebrow">
                <span class="badge rounded-pill text-bg-success">Client side</span>
                Private by design              </div>

              <div class="eyebrow">
                  <iconify-icon icon="lucide:zap" inline></iconify-icon>
                  Instant compression              </div>

              <div class="eyebrow">
                <iconify-icon icon="lucide:shield-check" inline></iconify-icon>
                No file limits              </div>
            </div>

            <div class="hero-badges d-flex flex-wrap justify-content-center gap-3 mt-3">
              <div class="eyebrow">
                <span class="badge rounded-pill text-bg-success">Zip</span>
                .zip
              </div>

              <div class="eyebrow">
                <span class="badge rounded-pill text-bg-success">Rar</span>
                .rar
              </div>

              <div class="eyebrow">
                <span class="badge rounded-pill text-bg-success">7-Zip</span>
                .7z
              </div>

              <div class="eyebrow">
                <span class="badge rounded-pill text-bg-success">Tar</span>
                  .tar, .tar.gz, .tar.bz2
              </div>
            </div>
          </div>

        </div>
      </div>
    </section>

    <div class="container">
      <div class="banner top">
        <!-- AdSense banner --><div class="adsbygoogle" style="display:inline-block;" data-ad-client="ca-pub-5029257013560698" data-ad-slot="9242083494"></div>
	<!-- /AdSense banner -->      </div>
    </div>

    <section id="tools" class="my-5">
      <div class="container">
        <!--<div class="text-uppercase small text-secondary fw-semibold mb-2 text-center">Workspace</div>-->

        <div class="glass-card p-3 p-lg-4 gradient">

          <div class="nav tool-tabs justify-content-center mb-4" id="toolTabs" role="tablist">
            <button class="nav-link active" id="zip-tab" data-bs-toggle="pill" data-bs-target="#zip-pane" type="button" role="tab">Create ZIP</button>
            <button class="nav-link" id="unzip-tab" data-bs-toggle="pill" data-bs-target="#unzip-pane" type="button" role="tab">Extract ZIP</button>
          </div>

          <div class="tab-content">
            <div class="tab-pane fade show active" id="zip-pane" role="tabpanel">

              <div class="card card-text">
                <div class="card-body">
                  <div class="align-items-center">
                    <div class="icon-wrap mb-3">
                      <iconify-icon icon="streamline-ultimate:zip-file-compress" style="font-size:3rem"></iconify-icon>
                    </div>
                    <h3 class="h4 mb-2">Create a ZIP archive</h3>

                    <p class="text-secondary mb-0">
                      Drop or select multiple files and folders, set an archive name, and generate a downloadable ZIP instantly.                    </p>

                    <div class="d-flex justify-content-center gap-2 flex-wrap mt-4 mb-1">
                      <button class="btn btn-primary px-4 fileBtn"><iconify-icon icon="lucide:upload" inline></iconify-icon> Choose files</button>
                      <button class="btn btn-primary px-4 folderBtn"><iconify-icon icon="lucide:folder-up" inline></iconify-icon> Choose folder</button>
                    </div>
                    <small class="text-secondary">or press [Ctrl]-v to paste from clipboard</small>

                  </div>
                </div>
              </div><!--/.card-text-->

              <div class="card card-tree d-none">
                <div class="card-header">

                  <div class="float-end small">
                    <div class="resetBtn" data-process="zip"><iconify-icon icon="lucide:trash-2" inline></iconify-icon> Clear all</div>
                  </div>

                  <div class="summary"><strong>0 files</strong></div>
                  <small>
                    Click <span class="lucide--trash text-danger" style="vertical-align:-0.15rem"></span> to delete.                    Click <span class="lucide--eye" style="vertical-align:-0.15rem"></span> for preview.                  </small>
                </div>
                <div class="zip-tree-wrap">
                  <ul class="zip-tree"></ul>
                </div>

                <div class="text-center p-3">
                  <button class="btn btn-primary px-4 fileBtn"><iconify-icon icon="lucide:upload" inline></iconify-icon> Add file(s)</button>
                  <button class="btn btn-primary px-4 folderBtn"><iconify-icon icon="lucide:folder-up" inline></iconify-icon> Add folder</button>
                </div>
              </div><!--/.card-tree-->

              <div id="archiveProperties" class="p-3 rounded-4 border mt-4 d-none" style="background:var(--bs-primary-bg-subtle)">

                <div class="row mb-3">
                  <label for="archiveFilename" class="col-sm-4 col-form-label">Archive name</label>
                  <div class="col-sm-8">
                    <input id="archiveFilename" class="form-control form-control" type="text" placeholder="" value="Files.zip" maxlength="80">
                  </div>
                </div>

                <div class="row mb-3">
                  <label for="archivePassword" class="col-sm-4 col-form-label">Archive password</label>
                  <div class="col-sm-8">
                    <input id="archivePassword" class="form-control form-control" type="text" maxlength="80">
                  </div>
                </div>

                <div class="d-grid gap-2 d-sm-flex">
                  <button class="btn btn-primary flex-fill" id="createArchiveBtn">Create archive</button>
                  <button class="btn btn-soft flex-fill resetBtn" data-process="zip">Cancel</button>
                </div>

                <div id="zipProgress" class="mt-3">
                  <div></div>
                </div>

              </div><!--/#archiveProperties-->

              <div id="archiveResult" class="card mt-4 d-none">
                <div class="card-header">
                  <h4 class="h4 fw-bold m-0">Archive ready!</h4>
                  <p class="mb-0 label-muted archiveSummary"></p>
                </div>

                <div class="d-grid gap-3 p-4">
                  <div class="summary-row d-flex align-items-center justify-content-between">
                    <div class="d-flex align-items-center gap-2 label-muted">
                      <span>Archive name</span>
                    </div>
                    <div class="value-main archiveName">Files.zip</div>
                  </div>

                  <div class="summary-row d-flex align-items-center justify-content-between">
                    <div class="d-flex align-items-center gap-2 label-muted">
                      <span>Archive password</span>
                    </div>
                    <div class="value-main archivePassword"></div>
                  </div>

                  <div class="summary-row d-flex align-items-center justify-content-between">
                    <div class="label-muted">Original size</div>
                    <div class="value-main archiveOrgSize">0</div>
                  </div>

                  <div class="summary-row d-flex align-items-center justify-content-between">
                    <div class="label-muted">Compressed size</div>
                    <div class="value-main archiveCompressedSize">0</div>
                  </div>

                  <div class="summary-row highlight d-flex align-items-center justify-content-between">
                    <div class="d-flex align-items-center gap-2 label-muted">
                      <span>Space saved</span>
                    </div>
                    <div class="text-end">
                      <div class="value-main fw-bold archiveSpaceSavedPerc">0%</div>
                      <div class="value-sub archiveSpaceSavedBytes">0</div>
                    </div>
                  </div>
                </div>

                <div class="card-footer">
                  <div class="d-grid gap-2 d-sm-flex">
                    <button class="btn btn-primary flex-fill" id="downloadArchiveBtn"><iconify-icon icon="lucide:download" inline></iconify-icon> Download</button>
                    <button class="btn btn-primary flex-fill" id="emailArchiveBtn"><iconify-icon icon="lucide:mail" inline></iconify-icon> Email</button>
                    <button class="btn btn-primary flex-fill" id="dropboxArchiveBtn"><iconify-icon icon="mdi:dropbox" inline></iconify-icon> Dropbox</button>
                  </div>
                </div>
              </div>
            </div>

            <div class="tab-pane fade" id="unzip-pane" role="tabpanel">

              <div class="card card-text">
                <div class="card-body">
                  <div class="align-items-center">
                    <div class="icon-wrap mb-3">
                      <iconify-icon icon="hugeicons:file-zip" style="font-size:3rem"></iconify-icon>
                    </div>
                    <h3 class="h4 mb-2">Extract a ZIP archive</h3>
                    <p class="text-secondary mb-0">Drag or select a ZIP file in (RAR, TAR and 7-Zip are also supported), preview its contents, and download individual files or everything at once.</p>

                    <div class="d-flex justify-content-center gap-2 flex-wrap mt-4">
                      <button class="btn btn-primary px-4" id="chooseZipFileBtn"><iconify-icon icon="lucide:upload" inline></iconify-icon> Choose archive file</button>
                    </div>
                    <small class="text-secondary">or press [Ctrl]-v to paste from clipboard</small>
                  </div>
                </div>
              </div><!--/.card-text-->

              <div class="card card-tree d-none">
                <div class="card-header">
                  <div class="float-end small">
                    <div class="resetBtn" data-process="unzip"><iconify-icon icon="lucide:trash-2" inline></iconify-icon> Clear all</div>

                    <div class="form-check">
                      <input class="form-check-input" type="checkbox" value="" id="checkHiddenFiles">
                      <label class="form-check-label" for="checkHiddenFiles">
                        Show hidden files                      </label>
                    </div>
                  </div>

                  <div class="summary"><strong>0 files</strong></div>
                  <small>
                    Click files to download or <a id="downloadAllBtn" href="#">download them all</a>.                    Click <span class="lucide--eye" style="vertical-align:-0.15rem"></span> for preview.                    Click <span class="lucide--archive-restore" style="vertical-align:-0.15rem"></span> to unzip.                  </small>
                </div>
                <div class="zip-tree-wrap">
                  <ul class="zip-tree"></ul>
                </div>
              </div><!--/.card-tree-->

            </div>
          </div>
        </div>
      </div>
    </section>

    <div class="container">
      <div class="banner bottom">
        <!-- AdSense banner --><div class="adsbygoogle" style="display:inline-block;" data-ad-client="ca-pub-5029257013560698" data-ad-slot="4911383614"></div>
