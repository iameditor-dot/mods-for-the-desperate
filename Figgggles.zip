  <div id="downloadAllDiv" class="overlay">
    <div class="align-items-center">
      <div class="closeBtn"></div>

      <div class="w-100 p-3">
        <h2 class="text-center">Download all files</h2>
        <div class="status text-center mx-auto my-2 text-truncate" style="width:80vw">&nbsp;</div>
        <div class="progress w-100" style="height:3em">
          <div class="progress-bar progress-bar-striped"></div>
        </div>
        <div class="boxy"></div>
      </div>
    </div>
  </div>

  <div id="emailDiv" class="overlay">
    <div>
      <div class="closeBtn"></div>

      <div class="w-75 p-3">
        <h2 class="text-center mb-5">Send ZIP file by email</h2>

        <form style="margin:1em auto">

          <div class="form-floating mb-3">
            <input name="sender_name" class="form-control" id="sender_name" type="text" placeholder="Your name" spellcheck="false">
            <label for="sender_name">Your name</label>
          </div>

          <div class="form-floating mb-3">
            <input name="sender_email" class="form-control" id="sender_email" type="email" placeholder="name@example.com">
            <label for="sender_email">Your email address</label>
          </div>

          <div class="form-floating mb-3">
            <input name="rcpt_email" class="form-control" id="rcpt_email" type="email" placeholder="name@example.com">
            <label for="rcpt_email">Recipient email address</label>
          </div>

          <div class="form-floating mb-3">
            <input name="subject" class="form-control" id="subject" type="text" placeholder="name@example.com">
            <label for="subject">Subject</label>
          </div>

          <div class="form-floating mb-3">
            <textarea name="message" class="form-control" id="message" placeholder="Your message" style="height: 10rem"></textarea>
            <label for="message">Your message</label>
          </div>

          <!-- Submit Button-->
          <div class="d-grid"><button class="btn btn-primary btn-xl py-2" type="submit">Send</button></div>
        </form>
      </div>
    </div>
  </div>

</body>
</html>
